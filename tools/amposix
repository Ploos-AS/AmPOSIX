#!/usr/bin/env python3
"""AmPOSIX host-side porting assistant (M1 prototype)."""
from __future__ import annotations
import argparse, json, pathlib, re, sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
DB = ROOT / "data" / "features.json"
C_SUFFIXES = {".c", ".h", ".cc", ".cpp", ".cxx", ".hpp"}

def load_db(path: pathlib.Path):
    return json.loads(path.read_text(encoding="utf-8"))["features"]

def source_files(root: pathlib.Path):
    if root.is_file():
        yield root
        return
    for p in root.rglob("*"):
        if p.is_file() and p.suffix.lower() in C_SUFFIXES:
            yield p

def scan(root: pathlib.Path, db):
    found = {}
    patterns = {name: re.compile(r"(?<![A-Za-z0-9_])" + re.escape(name) + r"\s*\(")
                for name in db}
    for path in source_files(root):
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        for name, pattern in patterns.items():
            if pattern.search(text):
                found.setdefault(name, set()).add(str(path))
    return found

def report(found, db):
    order = ["native", "header", "library", "adapt", "unsupported", "investigate"]
    grouped = {k: [] for k in order}
    for name in sorted(found):
        grouped.setdefault(db[name]["class"], []).append(name)
    print("AmPOSIX portability report")
    print("==========================")
    print(f"Known interfaces detected: {len(found)}")
    for cls in order:
        names = grouped.get(cls, [])
        if not names:
            continue
        print(f"\n{cls.upper()}")
        for name in names:
            meta = db[name]
            note = meta.get("note")
            suffix = f" — {note}" if note else ""
            print(f"  {name} [{meta.get('area','other')}]{suffix}")

def main(argv=None):
    parser = argparse.ArgumentParser(prog="amposix")
    parser.add_argument("--database", type=pathlib.Path, default=DB)
    sub = parser.add_subparsers(dest="command", required=True)
    s = sub.add_parser("scan", help="scan C/C++ source for known portability interfaces")
    s.add_argument("source", type=pathlib.Path)
    args = parser.parse_args(argv)
    if args.command == "scan":
        if not args.source.exists():
            parser.error(f"source does not exist: {args.source}")
        db = load_db(args.database)
        report(scan(args.source, db), db)
        return 0
    return 2

if __name__ == "__main__":
    sys.exit(main())
